#!/bin/bash
# Launcher for Sill. Single instance: GTK's application-id handling makes a
# second invocation forward its command line (e.g. `sill toggle`) to the
# running one. Subcommands: (none)=run · toggle · show [tab] · purge · doctor [--self-test]
exec python3 "$HOME/.local/share/sill/main.py" "$@"
