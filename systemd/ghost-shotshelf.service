[Unit]
Description=Screenshot shelf
Documentation=file://%h/.config/omarchy/CUSTOMISATIONS.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ghost-shotshelf
# It died once mid-session with no coredump, no journal entry and nothing to
# restart it -- the first anyone knew was pressing PRINT and getting nothing.
# launch_on_start fires and forgets; this supervises, and gives us
# `journalctl --user -u ghost-shotshelf` when it next misbehaves.
Restart=on-failure
RestartSec=3
Slice=app.slice

[Install]
WantedBy=graphical-session.target
